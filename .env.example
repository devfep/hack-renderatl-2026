# Copy to .env and fill in. .env is gitignored - never commit real values.

# Which Store backend the agent queries: duckdb | snowflake
ATL_STORE=duckdb
ATL_DUCKDB_PATH=data/atl.duckdb

# Snowflake. SF_ACCOUNT is the <orgname>-<accountname> identifier, NOT the full URL.
SF_ACCOUNT=
SF_USER=
SF_PAT=
SF_WAREHOUSE=COMPUTE_WH
SF_DATABASE=ATL
SF_SCHEMA=PUBLIC
SF_ROLE=ACCOUNTADMIN
SF_CORTEX_MODEL=claude-sonnet-4-5

# Gemini, for the ADK agent's own reasoning
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
